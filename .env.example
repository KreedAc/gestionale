# --- Database Turso ---
# Crea un database su https://turso.tech e copia URL e token:
#   turso db create gestionale
#   turso db show gestionale --url
#   turso db tokens create gestionale
TURSO_DATABASE_URL="libsql://il-tuo-db.turso.io"
TURSO_AUTH_TOKEN="il-tuo-token"

# --- Accesso (utente singolo) ---
# Genera questi tre valori con: npm run secrets -- "la-tua-password"
APP_USERNAME="admin"
APP_PASSWORD_HASH="hash-bcrypt-generato"
SESSION_SECRET="segreto-per-firmare-i-cookie"

# --- Cifratura dei segreti a riposo (AES-256-GCM) ---
# 32 byte in base64. Generata dallo stesso comando "npm run secrets".
# ATTENZIONE: se la perdi non puoi piu' decifrare i dati salvati.
ENCRYPTION_KEY="chiave-32-byte-base64"
